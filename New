-- Lọc và chặn các Remote nghi vấn dùng để phát hiện Hack/Speed/Teleport
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if Config.BlockFlaggedRemotes and not checkcaller() then
        if method == "FireServer" or method == "InvokeServer" then
            local remoteName = string.lower(self.Name)
            if remoteName:find("cheat") or remoteName:find("ban") or remoteName:find("detect") or remoteName:find("flag") or remoteName:find("check") then
                return nil -- Chặn Remote báo cáo Hack về Server
            end
        end
    end
    return oldNamecall(self, ...)
end)

