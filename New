local function GetBaseName(fullName)
    local baseName = string.match(fullName, "^(.-)_%d+$")
    return baseName or fullName
end

local function GetNearbyMMORPGMobs()
    local mobBaseNames = {}
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return mobBaseNames end

    local hrp = char.HumanoidRootPart

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v ~= char then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local mHrp = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart or v:FindFirstChild("Torso")
            
            if hum and mHrp and hum.Health > 0 and not Players:GetPlayerFromCharacter(v) then
                local dist = (mHrp.Position - hrp.Position).Magnitude
                if dist <= Config.Range then
                    local cleanName = GetBaseName(v.Name)
                    if not table.find(mobBaseNames, cleanName) then
                        table.insert(mobBaseNames, cleanName)
                    end
                end
            end
        end
    end
    return mobBaseNames
end

