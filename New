-- LOGIC AUTO PICKUP
task.spawn(function()
    while true do
        if Config.AutoPickup and WorldItems and PickupEvent then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local myPos = char.HumanoidRootPart.Position
                    local itemsToPickup = {}

                    for _, item in ipairs(WorldItems:GetChildren()) do
                        local itemPos = nil
                        if item:IsA("BasePart") then
                            itemPos = item.Position
                        elseif item:IsA("Model") then
                            itemPos = item:GetPivot().Position
                        end

                        if itemPos then
                            local dist = (myPos - itemPos).Magnitude
                            if dist <= Config.PickupRange then
                                table.insert(itemsToPickup, item)
                            end
                        else
                            table.insert(itemsToPickup, item)
                        end
                    end

                    if #itemsToPickup > 0 then
                        isPickingUp = true
                        for _, item in ipairs(itemsToPickup) do
                            if not Config.AutoPickup then break end
                            PickupEvent:FireServer({ pickupId = item.Name })
                            task.wait(Config.PickupDelay + (math.random(1, 5) / 100)) -- Thêm delay ngẫu nhiên nhỏ
                        end
                        isPickingUp = false
                    end
                end
            end)
        else
            isPickingUp = false
        end
        task.wait(0.2)
    end
end)

