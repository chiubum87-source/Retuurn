end)

-- MAIN FARM LOOP
RunService.Heartbeat:Connect(function()
    if isPickingUp then return end

    if Config.AutoFarm and Config.SelectedMobBaseName and not string.find(Config.SelectedMobBaseName, "Không") then
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end

        local targetMob = nil
        local shortestDist = math.huge

        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and v ~= char then
                if GetBaseName(v.Name) == Config.SelectedMobBaseName then
                    local mHum = v:FindFirstChildOfClass("Humanoid")
                    local mHrp = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart or v:FindFirstChild("Torso")
                    
                    if mHum and mHrp and mHum.Health > 0 and not Players:GetPlayerFromCharacter(v) then
                        local dist = (mHrp.Position - char.HumanoidRootPart.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            targetMob = v
                        end
                    end
                end
            end
        end

        if targetMob then
            local mHrp = targetMob:FindFirstChild("HumanoidRootPart") or targetMob.PrimaryPart or targetMob:FindFirstChild("Torso")
            if mHrp then
                local hrp = char.HumanoidRootPart
                
                -- Random Position Offset (Chống soi Tọa độ cố định)
                local offsetX = Config.RandomOffset and (math.random(-25, 25) / 10) or 0
                local offsetZ = Config.RandomOffset and (math.random(-25, 25) / 10) or 0
                
                local targetCFrame
                if Config.PositionMode == "Above" then
                    targetCFrame = mHrp.CFrame * CFrame.new(offsetX, Config.Height, offsetZ) * CFrame.Angles(math.rad(-90), 0, 0)
                elseif Config.PositionMode == "Below" then
                    targetCFrame = mHrp.CFrame * CFrame.new(offsetX, -Config.BelowDepth, offsetZ) * CFrame.Angles(math.rad(90), 0, 0)
                elseif Config.PositionMode == "Behind" then
                    targetCFrame = mHrp.CFrame * CFrame.new(offsetX, 0, Config.BehindDistance + offsetZ)
                end

                if Config.MovementMethod == "Walk" then
                    if currentTween then
                        currentTween:Cancel()
                        currentTween = nil
                    end
                    hum.WalkSpeed = Config.FarmWalkSpeed
                    hum:MoveTo(targetCFrame.Position)

                elseif Config.MovementMethod == "Tween" then
                    local distance = (hrp.Position - targetCFrame.Position).Magnitude
                    local duration = distance / Config.TweenSpeed

                    if distance > 3 then
                        if not currentTween or currentTween.PlaybackState ~= Enum.PlaybackState.Playing then
                            local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                            currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
                            currentTween:Play()
                        end
                    else
                        hrp.CFrame = targetCFrame
                    end

                elseif Config.MovementMethod == "Teleport" then
                    if currentTween then 
                        currentTween:Cancel() 
                        currentTween = nil
                    end
                    hrp.CFrame = targetCFrame
                end

                -- Tấn công với độ trễ biến thiên tự nhiên
                local dynamicDelay = Config.SafeAttackDelay + (math.random(-2, 3) / 100)
                if (tick() - lastAttackTime) >= dynamicDelay then
                    lastAttackTime = tick()

                    if Config.UseGroundSlamRemote and GroundSlamEvent then
                        GroundSlamEvent:FireServer(mHrp.Position, Config.SelectedWeapon, 0)
                    end

                    if Config.AutoAttack then
                        AutoClickAttackUI()
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(500, 500))
                    end

                    if Config.FarmDelay > 0 then
                        task.wait(Config.FarmDelay)
                    end
                end
            end
        end
    else
        if currentTween then
            currentTween:Cancel()
            currentTween = nil
        end
    end
end)